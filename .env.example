# Deal Onboarding — environment template. Copy to .env and fill in.
# Every value here is a placeholder; nothing in this file is a real secret.

HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
FRONTEND_DIST_DIR=./frontend/dist
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Operator identity ────────────────────────────────────────────────────────
# ORG_NAME fills the Curator slot (slot 1) of every generated deal name when no
# data partner is set. Letters/digits/space/dot/hyphen survive sanitization.
ORG_NAME=Curator
# CAMPAIGN_ID_PREFIX + five digits is the campaign-id format the audit requires
# (e.g. DEAL00042). Uppercase letters/digits, 2–8 chars, starting with a letter.
CAMPAIGN_ID_PREFIX=DEAL
# Default attribution code for slot 12 of the deal name (form may override).
DEFAULT_ATTRIBUTION_CODE=A1

# ── Login ────────────────────────────────────────────────────────────────────
# Email/password login backed by a JSON user store (deal-onboarding-admin user
# add). The session cookie is HMAC-signed with this secret (>= 32 chars).
DEAL_ONBOARDING_USER_STORE=./data/users.json
DEAL_ONBOARDING_SESSION_SECRET=replace-with-a-random-32-char-secret

# ── Standard-list library ────────────────────────────────────────────────────
# DEAL_ONBOARDING_LISTS_DIR holds the repo-shipped, versioned lists (deployed
# via rsync). Trader-created lists ("save as a standard list") persist under
# DEAL_ONBOARDING_LISTS_RUNTIME_DIR, which defaults to $DATA_DIR/lists so a
# deploy's `rsync --delete` never wipes them. Leave both unset in most
# deployments — the defaults are correct.
# DEAL_ONBOARDING_LISTS_DIR=./lists
# DEAL_ONBOARDING_LISTS_RUNTIME_DIR=./data/lists

# Known-publisher snapshot behind the allowlist chips' advisory validation.
# Missing file = feature quietly off. Regenerate with scripts/gen-publisher-catalog.mjs.
# DEAL_ONBOARDING_PUBLISHER_CATALOG=./catalogs/publisher-catalog.json

# ── LLM features (OpenRouter) ────────────────────────────────────────────────
# Required for "Parse Deal Data", the AI audit, and the Deal Assistant dock.
# Get a key at https://openrouter.ai/keys — leave blank to disable all three.
OPENROUTER_API_KEY=
# Optional model overrides (OpenRouter slugs). Unset = the built-in defaults
# listed in internal/handlers/models_catalog.go.
# OPENROUTER_MODEL=
# OPENROUTER_AUDIT_MODEL=
# OPENROUTER_CHAT_EDIT_MODEL=
# OPENROUTER_IMPORT_MODEL=

# ── Runner (deal-booking engine) submission ─────────────────────────────────
# Deal Onboarding submits an audited batch to a task-runner through ONE seam
# (POST /api/runner/create). Leave BASE_URL/API_KEY empty to keep submission
# OFF — the Create button returns a clear "not configured" note and the app
# never touches the network. BACKEND is "fleet" (versioned /v1 task API) or
# "moc" (legacy task API). RUNNER_PERSONA names the agent persona the runner
# should load; leave it blank unless your runner bundle defines one.
#
# PRODUCTION slot — traders book against this one.
RUNNER_BACKEND=fleet
RUNNER_BASE_URL=
RUNNER_API_KEY=
RUNNER_MODEL=
RUNNER_FALLBACK_MODEL=
RUNNER_PERSONA=
RUNNER_MCP_SERVERS=
# Optional: pin every task onto a specific runner node (exact node name).
RUNNER_TARGET_NODE=

# Optional DEV slot. When BOTH RUNNER_DEV_BASE_URL and RUNNER_DEV_API_KEY are
# set, the create flow shows an environment picker (defaulting to Production)
# and a submit may carry mocEnv:"dev" to run here. Unset → picker hidden.
#
# BASE URL MUST BE THE BARE ORIGIN — no path. The app appends /v1/tasks,
# /v1/upload, /api-info and the task link path itself.
#
# NOTE: "dev" picks which runner executes the task, NOT whether the deals are
# real — a dev runner holding live SSP credentials books deals that are just
# as real as prod's.
RUNNER_DEV_BACKEND=fleet
RUNNER_DEV_BASE_URL=
RUNNER_DEV_API_KEY=
RUNNER_DEV_MODEL=
RUNNER_DEV_FALLBACK_MODEL=
RUNNER_DEV_PERSONA=
RUNNER_DEV_MCP_SERVERS=

# Legacy aliases still honored: MOC_BASE_URL / MOC_API_KEY / MOC_TARGET_NODE /
# MOC_MODEL / MOC_FALLBACK_MODEL (prod slot only) and MANIFEST_USER_STORE /
# MANIFEST_SESSION_SECRET / MANIFEST_LISTS_DIR / MANIFEST_LISTS_RUNTIME_DIR /
# MANIFEST_PUBLISHER_CATALOG. Prefer the names above.
